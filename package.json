{
    "name": "cyberbot",
    "type": "module",
    "version": "1.0.0",
    "description": "CyberBOT - Premium Discord Moderation Bot",
    "main": "dist/index.js",
    "scripts": {
        "dev": "node --import tsx/esm --watch src/index.ts",
        "build": "tsc && node scripts/copy-public.mjs",
        "start": "node dist/index.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "pm2:start": "pm2 start ecosystem.config.cjs",
        "pm2:stop": "pm2 stop cyberbot",
        "pm2:restart": "pm2 restart cyberbot",
        "pm2:logs": "pm2 logs cyberbot --lines 50",
        "pm2:status": "pm2 status"
    },
    "keywords": [
        "discord",
        "bot",
        "moderation",
        "cyberbot"
    ],
    "author": "CyberBOT",
    "license": "MIT",
    "engines": {
        "node": "22.x"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.68.0"
    },
    "dependencies": {
        "@discordjs/builders": "^1.14.1",
        "@discordjs/voice": "^0.19.2",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "chalk": "^4.1.2",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "effect": "^3.22.1",
        "express": "^5.2.1",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.9.1",
        "zod": "^4.4.3"
    }
}
